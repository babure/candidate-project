# Keep the Docker build context small and cache-friendly.
.git
.cursor
**/.DS_Store
**/Thumbs.db

# Frontend artifacts (rebuilt in the image)
frontend/node_modules
frontend/dist
frontend/pnpm-lock.yaml

# Backend artifacts
backend/target
backend/.mvn
backend/**/*.iml

# Local / docs noise not needed for the image
**/agent-transcripts
**/*.log
**/.idea
**/.vscode
